# VendorMart Environment Configuration Example
# Copy this file to .env and customize with your local MySQL credentials

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=localvendorpricecomparisonsystem

# Optional Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=vendormart-super-secret-key-2026

# Admin Default Seed (Optional)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
